{{!-- sw25-ce: Combat-tab Weapons list (approved mockup). One card per weapon; unequipped weapons are dimmed.
      Numbers come from item.system._battle (same math as the Accuracy / Damage tiles). Buttons post the
      attack / damage cards for THIS weapon by item id. Click the name for description + edit / delete. --}}
<ol class="items-list sw25-wlist">
  {{#each weaponCards as |w|}}
  <li class="item sw25-wc{{#unless w.equipped}} off{{/unless}}" data-item-id="{{w.id}}">
    <div class="sw25-wc-row">
      <div class="sw25-wc-left">
        <img class="sw25-wc-ic" src="{{w.img}}" alt="" data-tooltip="{{w.name}}" onerror="this.onerror=null;this.src='systems/sw25-ce/assets/icons/weapon.svg'">
        <div class="sw25-wc-nm">
          <b class="item-label" data-tooltip="Show description, edit and delete">{{w.name}}{{#if w.dedicated}} ({{localize "SW25.Item.Dedicated"}}){{/if}}</b>
          {{#if w.sub}}<small>{{w.sub}}</small>{{/if}}
          <label class="sw25-wc-eq{{#if w.equipped}} on{{/if}}" data-tooltip="Click to equip / unequip this weapon">
            <input class="eq-change" type="checkbox" name="system.equip" data-dtype="Boolean" {{#if w.equipped}}checked{{/if}} {{#unless @root.isOwner}}disabled{{/unless}}/>
            {{#if w.equipped}}&#10003; Equipped{{else}}Not equipped{{/if}}
          </label>
        </div>
      </div>
      <div class="sw25-wc-tiles">
        <div class="stat" data-tooltip="Weapon class skill used for accuracy and damage"><div class="v sm">{{w.cls}}</div><div class="n">Class</div></div>
        <div class="stat" data-tooltip="Accuracy check total: 2d6 + this value"><div class="v">{{w.acc}}</div><div class="n">Accuracy</div></div>
        <div class="stat dmg" data-tooltip="Power table / crits on this 2d6 total or higher / flat bonus damage"><div class="v sm">{{w.dmg}}</div><div class="n">Power / Crit / Bonus</div></div>
        {{#if w.range}}<div class="stat" data-tooltip="Maximum range"><div class="v sm">{{w.range}}</div><div class="n">Range</div></div>{{/if}}
      </div>
      <div class="sw25-wc-btns">
        <button type="button" class="sw25-wpn-acc" data-tooltip="Roll 2d6 + Accuracy against the target's Evasion">Roll Accuracy</button>
        <button type="button" class="sw25-wpn-dmg alt" data-tooltip="Roll 2d6 on the Power table and add the bonus">Roll Damage</button>
      </div>
    </div>
    <div class="item-description nogapmargin">
      <div class="flexrow">
        <div class="sw25-wc-desc">{{{w.description}}}</div>
        <div class="item-controls" style="flex: 0 0 50px;">
          {{#if @root.isOwner}}
          <a class="item-control item-edit" data-tooltip='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.weapon")}}'><i class="fas fa-edit"></i></a>
          <a class="item-control item-delete" data-tooltip='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.weapon")}}'><i class="fas fa-trash"></i></a>
          {{else}}
          <a class="item-control item-edit" data-tooltip='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.weapon")}}'><i class="fa-solid fa-eye"></i></a>
          {{/if}}
        </div>
      </div>
    </div>
  </li>
  {{else}}
  <li class="sw25-wc-empty">No weapons yet. Drag a weapon from the Items directory or a compendium onto this sheet.</li>
  {{/each}}
</ol>
