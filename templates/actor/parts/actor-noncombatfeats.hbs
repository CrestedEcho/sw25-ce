{{!-- Compact view of the SAME embedded feat items flagged nonCombat; the full list lives in the Combat area. --}}
<ol class='items-list sw25-noncombat'>
  {{#each nonCombatFeats as |item id|}}
  <li class='item flexrow' data-item-id='{{item._id}}'>
    <div class='item-name'><img class="roll-icon" src='{{item.img}}' width="20" height="20"/> <h4 class="item-edit" style="cursor:pointer">{{item.name}}</h4></div>
    {{#if ../isOwner}}<div class='item-controls'><a class='item-control item-edit'><i class='fas fa-edit'></i></a><a class='item-control item-delete'><i class='fas fa-trash'></i></a></div>{{/if}}
  </li>
  {{else}}<li class="item muted">—</li>{{/each}}
</ol>
