<div class="panel ce7-feats"><span class="ribbon">{{localize "SW25.V2.Feats.Title"}}</span>
  <p class="ce7-feat-hint"><i class="fas fa-circle-info"></i> {{localize "SW25.V2.Feats.Hint"}}</p>
  <h4 class="ce7-feat-h">{{localize "SW25.V2.Feats.Chosen"}}</h4>
  <div class="ce7-feat-slots">
    {{#each ce7feats.slots as |s|}}
    <div class="ce7-feat-slot {{#if s.locked}}locked{{/if}} {{#if s.item}}filled ce7-drag{{/if}}" data-sw-drop="feat" data-level="{{s.level}}" {{#if s.item}}data-item-id="{{s.item.id}}" draggable="true"{{/if}} data-tooltip="{{#if s.locked}}{{s.lockTip}}{{else}}{{#if s.item}}{{localize 'SW25.V2.Feats.SlotTip'}}{{else}}{{localize 'SW25.V2.Feats.EmptyTip'}}{{/if}}{{/if}}">
      <span class="lv">{{localize "SW25.V2.Feats.Slot" level=s.level}}</span>
      {{#if s.item}}
        <img src="{{s.item.img}}" alt=""/>
        <a class="ce7-feat-show nm">{{s.item.name}}</a>
        <a class="rollable ce7-roll" data-roll-type="item" draggable="false" data-tooltip="Roll / post card"><i class="fas fa-dice-d6"></i></a><span class="sw-acts"></span>
        <a class="ce7-feat-clear" data-tooltip="{{localize 'SW25.V2.Feats.Remove'}}"><i class="fas fa-xmark"></i></a>
      {{else}}{{#if s.locked}}<span class="ph"><i class="fas fa-lock"></i> {{localize "SW25.V2.Feats.LockedShort"}}</span>{{else}}<span class="ph"><i class="fas fa-plus"></i> {{localize "SW25.V2.Feats.ClickToChoose"}}</span>{{/if}}{{/if}}
    </div>
    {{/each}}
  </div>
  <div class="ce7-feat-list unassigned" data-sw-drop="unassigned" data-tooltip="{{localize 'SW25.V2.Feats.UnassignedTip'}}"><h4>{{localize "SW25.V2.Feats.Unassigned"}}</h4>
    {{#each ce7feats.unassigned as |it|}}<div class="item ce7-row ce7-drag" draggable="true" data-item-id="{{it.id}}"><i class="fas fa-grip-vertical grip"></i><img src="{{it.img}}" alt=""/><a class="ce7-feat-show" data-tooltip="{{localize 'SW25.V2.Feats.ShowTip'}}">{{it.name}}</a><a class="rollable ce7-roll" data-roll-type="item" draggable="false" data-tooltip="Roll / post card"><i class="fas fa-dice-d6"></i></a><span class="sw-acts"></span><a class="ce7-feat-assign" data-tooltip="{{localize 'SW25.V2.Feats.AssignTip'}}"><i class="fas fa-arrow-up"></i> {{localize "SW25.V2.Feats.Assign"}}</a></div>{{/each}}
    {{#unless ce7feats.unassigned.length}}<div class="ce7-drop-row">{{localize "SW25.V2.Feats.UnassignedEmpty"}}</div>{{/unless}}
  </div>
  <div class="grid2">
    <div class="ce7-feat-list" data-sw-drop="auto" data-tooltip="{{localize 'SW25.V2.Feats.AutoTip'}}"><h4>{{localize "SW25.V2.Feats.Auto"}}</h4>
      {{#each ce7feats.auto as |it|}}<div class="item ce7-row ce7-drag" draggable="true" data-item-id="{{it.id}}"><img src="{{it.img}}" alt=""/><a class="ce7-feat-show" data-tooltip="{{localize 'SW25.V2.Feats.ShowTip'}}">{{it.name}}</a><a class="rollable ce7-roll" data-roll-type="item" draggable="false" data-tooltip="Roll / post card"><i class="fas fa-dice-d6"></i></a><span class="sw-acts"></span><a class="ce7-feat-clear" data-tooltip="{{localize 'SW25.V2.Feats.Remove'}}"><i class="fas fa-xmark"></i></a></div>{{/each}}
      <div class="ce7-drop-row"><i class="fas fa-plus"></i> {{localize "SW25.V2.Feats.DropFeat"}}</div>
    </div>
    <div class="ce7-feat-list" data-sw-drop="racial"><h4>{{localize "SW25.V2.Feats.Racial"}}</h4>
      {{#if @root.raceInfo}}<div class="item ce7-row sw-raceinfo" data-item-id="{{@root.raceInfo.id}}"><img src="{{@root.raceInfo.img}}" alt=""/><span class="sw-raceinfo-text" style="flex:1"><b>{{localize "SW25.RaceItem.Info"}}: {{@root.raceInfo.name}}</b>{{#if @root.raceInfo.languages}}<br><small>{{localize "SW25.RaceItem.Languages"}}: {{@root.raceInfo.languages}}</small>{{/if}}{{#if @root.raceInfo.restricted}}<br><small>{{localize "SW25.RaceItem.Restricted"}}: {{@root.raceInfo.restricted}}</small>{{/if}}</span><a class="item-edit" data-tooltip="Open"><i class="fas fa-pen-to-square"></i></a><a class="item-delete" data-tooltip="{{localize 'SW25.RaceItem.Remove'}}"><i class="fas fa-trash"></i></a></div>{{/if}}
      {{#if @root.raceInfo.hasAppearance}}<div class="sw-raceinfo-appearance"><b>{{localize "SW25.RaceItem.Appearance"}}</b>{{#if @root.raceInfo.portraits.length}}<div class="sw-race-portraits small">{{#each @root.raceInfo.portraits as |p|}}<figure class="sw-race-portrait" data-sex="{{p.key}}"><img src="{{p.src}}" alt="{{localize p.label}}"/><span class="sw-race-portrait-missing"><i class="fas fa-user"></i></span><figcaption>{{localize p.label}}</figcaption></figure>{{/each}}</div>{{/if}}{{#if @root.raceInfo.appearance}}<div class="sw-raceinfo-appearance-text">{{{@root.raceInfo.appearance}}}</div>{{/if}}</div>{{/if}}
      {{#each ce7feats.racial as |it|}}<div class="item ce7-row ce7-drag{{#if it.inactive}} sw-inactive{{/if}}" draggable="true" data-item-id="{{it.id}}"><i class="fas fa-grip-vertical grip"></i><img src="{{it.img}}" alt=""/><a class="ce7-feat-show" data-tooltip="{{localize 'SW25.V2.Feats.ShowTip'}}">{{it.name}}</a>{{#if it.raceLevel}}<span class="sw-race-lvpill" data-tooltip="{{#if it.inactive}}{{localize 'SW25.RaceItem.Inactive' level=it.raceLevel}}{{/if}}">{{localize "SW25.RaceItem.Applies" level=it.raceLevel}}</span>{{/if}}<a class="rollable ce7-roll" data-roll-type="item" draggable="false" data-tooltip="Roll / post card"><i class="fas fa-dice-d6"></i></a><span class="sw-acts"></span><a class="item-edit" data-tooltip="Open"><i class="fas fa-pen-to-square"></i></a></div>{{/each}}
    </div>
  </div>
</div>
