{{#with (sw25SpellRow item) as |row|}}
    <li class='item spell sw25-spellrow-li' data-item-id='{{../item._id}}'>
      <div class="sw25-spellrow">
        <div class="sw25-sr-icon">
          <a class='sw25-spell-cast' data-tooltip="Cast {{../item.name}}"><img src='{{../item.img}}' alt="" width="36" height="36"/></a>
        </div>
        <div class="sw25-sr-name">
          <div class="sw25-sr-title">
            {{#if (eq ../item.system.type "bibliomancer")}}
            <label class="equip-toggle" data-tooltip="Equipped"><input class="eq-change" type="checkbox" name="system.equip" data-dtype="Boolean" {{#if ../item.system.equip}}checked{{/if}}/></label>
            {{/if}}
            {{#if (eq ../item.system.fairytype "propfairy")}}<span class="{{../item.system.fairyprop}}"><i class="fa-solid fa-gem"></i></span>{{/if}}
            {{#if (eq ../item.system.fairytype "specialfairy")}}<span class="{{../item.system.fairytype}}"><i class="fa-solid fa-gem specialfairy-text"></i></span>{{/if}}
            <a class="sw25-spell-name" data-tooltip="Click: show this spell in chat (no MP is spent)">{{../item.name}}</a>
            {{#if row.hasStatus}}<i class="fa-solid fa-biohazard sw25-sr-status" data-tooltip="This spell can add a status effect"></i>{{/if}}
          </div>
          <div class="sw25-sr-sub">{{row.sub}}</div>
        </div>
        <div class="sw25-sr-cell sw25-sr-mp" data-tooltip="MP cost (before metamagic){{#if ../item.system.hpcost}} · HP {{../item.system.hpcost}}{{/if}}">{{row.mp}}{{#if ../item.system.hpcost}}<small> +HP{{../item.system.hpcost}}</small>{{/if}}</div>
        <div class="sw25-sr-cell sidebar-hidden" data-tooltip="Target">{{row.target}}</div>
        <div class="sw25-sr-cell sidebar-hidden" data-tooltip="Range">{{row.range}}</div>
        <div class="sw25-sr-cell sidebar-hidden" data-tooltip="Duration">{{row.duration}}</div>
        <div class="sw25-sr-actions">
          <button type="button" class="sw25-spell-cast sw25-sr-cast" data-tooltip="Open the cast window: choose metamagic and how to pay, then roll">Cast</button>
          <a class="sw25-spell-more" data-tooltip="Show the description here"><i class="fa-solid fa-chevron-down"></i></a>
          {{#if ../isOwner}}
          <a class='item-control item-edit' data-tooltip='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.spell")}}'><i class='fas fa-edit'></i></a>
          <a class='item-control item-delete' data-tooltip='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.spell")}}'><i class='fas fa-trash'></i></a>
          {{else}}
          <a class='item-control item-edit' data-tooltip='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.spell")}}'><i class='fa-solid fa-eye'></i></a>
          {{/if}}
        </div>
      </div>
      <div class="spell-description sw25-sr-desc" style="display:none">{{{../item.system.description}}}</div>
    </li>
{{/with}}
