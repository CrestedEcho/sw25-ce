{{!-- "Show All Spells" list on the PC Magic tab: every spell the PC has, in the same rows as the school sections
     (actor-spell-header/-item: one grid, Cast button -> cast window and power-table roll, "School · LvN" subtitle). --}}
<ol class='items-list sw25-spell-list sw25-allspells'>
  {{> "systems/sw25-ce/templates/actor/parts/actor-spell-header.hbs" title=(localize "SW25.V2.AllSpells") create=isOwner}}
  {{#each spells as |item id|}}
    {{> "systems/sw25-ce/templates/actor/parts/actor-spell-item.hbs" item=item isOwner=../isOwner}}
  {{else}}
    <li class="item sw25-allspells-empty">{{localize "SW25.V2.NoSpells"}}</li>
  {{/each}}
</ol>
