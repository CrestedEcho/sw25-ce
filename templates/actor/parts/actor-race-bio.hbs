{{!-- sw25-ce: race card on the Bio tab (portraits, appearance and description come from the race item). --}}
{{#if raceInfo}}
<div class="panel sw-bio-race" data-item-id="{{raceInfo.id}}"><span class="ribbon">{{localize "SW25.Race"}}: {{raceInfo.name}}</span>
  <div class="sw-bio-race-grid">
    {{#if raceInfo.portraits.length}}
    <div class="sw-race-portraits">{{#each raceInfo.portraits as |p|}}<figure class="sw-race-portrait" data-sex="{{p.key}}"><img src="{{p.src}}" alt="{{localize p.label}}"/><span class="sw-race-portrait-missing"><i class="fas fa-user"></i></span><figcaption>{{localize p.label}}</figcaption></figure>{{/each}}</div>
    {{/if}}
    <div class="sw-bio-race-text">
      <div class="item ce7-row sw-raceinfo" data-item-id="{{raceInfo.id}}"><img src="{{raceInfo.img}}" alt=""/><span class="sw-raceinfo-text"><b>{{raceInfo.name}}</b>{{#if raceInfo.languages}}<br><small>{{localize "SW25.RaceItem.Languages"}}: {{raceInfo.languages}}</small>{{/if}}{{#if raceInfo.restricted}}<br><small>{{localize "SW25.RaceItem.Restricted"}}: {{raceInfo.restricted}}</small>{{/if}}</span><a class="item-edit" data-tooltip="{{localize 'SW25.V2.Open'}}"><i class="fas fa-pen-to-square"></i></a><a class="item-delete" data-tooltip="{{localize 'SW25.RaceItem.Remove'}}"><i class="fas fa-trash"></i></a></div>
      {{#if raceInfo.appearance}}<h4 class="sw-bio-h">{{localize "SW25.RaceItem.Appearance"}}</h4><div class="sw-raceinfo-appearance-text">{{{raceInfo.appearance}}}</div>{{/if}}
      {{#if raceInfo.description}}<h4 class="sw-bio-h">{{localize "SW25.Description"}}</h4><div class="sw-bio-race-desc">{{{raceInfo.description}}}</div>{{/if}}
    </div>
  </div>
</div>
{{/if}}
