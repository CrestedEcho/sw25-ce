{{!-- sw25-ce: Classes card (Classes & Feats tab). View model: module/rules/class-card.mjs (context.classCard).
     Every number is a die button (.rollable, same data-roll/data-label as before) with a breakdown tooltip. --}}
{{#*inline "ccD6"}}<svg class="d6" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="4.5" fill="none" stroke="currentColor" stroke-width="2.2"/><circle cx="8" cy="8" r="1.8" fill="currentColor"/><circle cx="16" cy="16" r="1.8" fill="currentColor"/><circle cx="12" cy="12" r="1.8" fill="currentColor"/></svg>{{/inline}}
{{#*inline "ccTip"}}<span class="cc-tip" role="tooltip"><span class="sum">{{#each cell.parts}}{{#if op}} {{op}} {{/if}}{{label}} <b>{{abs}}</b>{{/each}} = <b>{{cell.total}}</b></span><br><span class="sub">{{localize "SW25.V2.ClassCard.ClickRoll"}} {{cell.formula}}</span></span>{{/inline}}
{{#*inline "ccCheck"}}{{#if chk.power}}<span class='item small-checkitem powerrollable sc' data-item-id='{{chk.id}}' data-roll="{{chk.formula}}" data-label="{{chk.name}}" data-pt="{{chk.powertable}}" data-apply="{{chk.applypower}}" data-powertype="{{chk.powerTypesButton}}">{{else}}<span class='item small-checkitem rollable sc' data-item-id='{{chk.id}}' data-roll="{{chk.formula}}+{{chk.checkbase}}" data-label="{{chk.name}}" data-pt="{{chk.powertable}}" data-apply="{{chk.applycheck}}" data-checktype="{{chk.checkTypesButton}}">{{/if}}{{> ccD6}}{{chk.name}} <b>{{chk.checkbase}}</b></span>{{/inline}}
<div class="cc{{#if system.isEdit}} is-edit{{/if}}">
  <div class="cc-top">
    <div class="cc-hint"><span class="mini">{{> ccD6}}5</span><span>{{localize "SW25.V2.ClassCard.HintClick"}} <b class="cc-hint-f">{{localize "SW25.V2.ClassCard.HintFormula"}}</b>&nbsp;·&nbsp;{{localize "SW25.V2.ClassCard.HintHover"}}</span></div>
    <div class="cc-exp">{{localize "SW25.Attributes.Exp"}}
      <span class="pill" data-tooltip="{{localize "SW25.Attributes.Useexp"}} / {{localize "SW25.Attributes.Totalexp"}}"><span class="{{#if classCard.exp.over}}warning-text{{/if}}">{{system.attributes.useexp}}</span> / {{#if system.isEdit}}<input id="{{actor._id}}exp" class="cc-exp-in" type="number" name="system.attributes.totalexp" value="{{system.attributes.totalexp}}" data-dtype="Number"/>{{else}}{{system.attributes.totalexp}}{{/if}}</span>
      <span class="bar{{#if classCard.exp.over}} over{{/if}}"><i style="width:{{classCard.exp.pct}}%"></i></span>
    </div>
  </div>

  <ol class="cc-list">
    <li class="cc-grid cc-head">
      <div>{{localize "SW25.Skillname"}}</div>
      <div data-tooltip="{{localize "SW25.V2.ClassCard.LvTip"}}">Lv</div>
      {{#each classCard.stats as |st|}}
      <div class="cc-st" data-stat="{{st.key}}" data-tooltip="{{st.longLabel}}"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/{{st.icon}}.svg)"></span><span class="st st-full">{{st.longLabel}}</span><span class="st st-abbr">{{st.abbrLabel}}</span></div>
      {{/each}}
      <div data-tooltip="{{localize "SW25.V2.ClassCard.ModTip"}}">{{localize "SW25.V2.ClassCard.Mod"}}</div>
      <div></div>
    </li>

    {{!-- Adventurer Level --}}
    <li class="item cc-row cc-adv">
      <div class="cc-grid">
        <div class="cc-advname"><span class="star">★</span><span class="nm">{{localize "SW25.Attributes.Advlevel"}}</span></div>
        <div class="cc-lv" data-tooltip="{{localize "SW25.Attributes.Advlevel"}}">{{system.attributes.advlevel.value}}</div>
        {{#each classCard.adv.cells as |cell|}}
        <span class="cc-roll rollable" data-stat="{{cell.key}}" data-roll="2d6+@abilities.{{cell.key}}.advbase" data-label="{{localize "SW25.Attributes.Advlevel"}}+{{cell.statLong}}{{localize "SW25.Ability.Bonus"}}" data-checktype="">{{> ccD6}}{{cell.value}}{{> ccTip cell=cell}}</span>
        {{/each}}
        <div class="cc-modcell"><input class="cc-mod{{#if classCard.adv.modSet}} set{{/if}}" type="text" name="system.attributes.advlevel.mod" value="{{system.attributes.advlevel.mod}}" placeholder="±0" data-dtype="Number" data-tooltip="{{localize "SW25.V2.ClassCard.ModTip"}}"/></div>
        <div></div>
      </div>
      {{#if classCard.adv.checks.length}}
      <div class="cc-checks small-checklist"><span class="cc-checks-lbl">{{localize "SW25.V2.ClassCard.AdvChecks"}}</span>
        {{#each classCard.adv.checks as |chk|}}{{> ccCheck chk=chk}}{{/each}}
      </div>
      {{/if}}
    </li>

    {{#each classCard.rows as |row|}}
    <li class="item cc-row cls sw25-class-row" data-item-id="{{row.id}}">
      <div class="cc-grid">
        <div class="cc-name"><span class="cc-chip item-label skill-open" data-tooltip="{{localize "SW25.V2.ClassCard.OpenTip"}}"><span class="ci"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/{{row.icon}}.svg)"></span></span><span class="nm">{{row.name}}</span></span></div>
        {{#if @root.system.isEdit}}
        <div class="cc-step"><a class="changesl-button" data-action="decrease" data-property="item.system.skilllevel">−</a><input class="sl-change" type="text" name="skilllevelInput" value="{{row.level}}" data-dtype="Number"/><a class="changesl-button" data-action="increase" data-property="item.system.skilllevel">+</a></div>
        {{else}}
        <div class="cc-lv">{{row.level}}</div>
        {{/if}}
        {{#each row.cells as |cell|}}
        <span class="cc-roll rollable" data-stat="{{cell.key}}" data-roll="2d6+{{cell.value}}" data-label="{{row.name}}+{{cell.statLong}}{{localize "SW25.Ability.Bonus"}}" data-checktype="">{{> ccD6}}{{cell.value}}{{> ccTip cell=cell}}</span>
        {{/each}}
        <div class="cc-modcell"><input class="cc-mod sc-change{{#if row.modSet}} set{{/if}}" type="text" name="skillModInput" value="{{row.modText}}" placeholder="±0" data-dtype="Number" data-tooltip="{{localize "SW25.V2.ClassCard.ModTip"}}"/></div>
        {{#if @root.system.isEdit}}
        <div class="cc-ctrl item-controls">
          <a class="item-control item-edit" data-tooltip="{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.skill")}}"><i class="fas fa-pen"></i></a>
          <a class="item-control item-delete" data-tooltip="{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.skill")}}"><i class="fas fa-trash"></i></a>
        </div>
        {{else}}<div></div>{{/if}}
      </div>
      <div class="item-description">
        <div class="cc-checks small-checklist">{{#each row.checks as |chk|}}{{> ccCheck chk=chk}}{{/each}}</div>
      </div>
    </li>
    {{/each}}
  </ol>
  {{#if system.isEdit}}
  <div class="cc-add"><a class="item-control item-create" data-type="skill" data-tooltip="{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.skill")}}">+ {{localize "SW25.V2.ClassCard.AddClass"}}</a></div>
  {{/if}}
</div>
