<form class="{{cssClass}} {{actor.type}} sw25v2-form" autocomplete="off">
<input type="checkbox" name="system.isSidebar" {{#if system.isSidebar}}checked{{/if}} data-dtype="Boolean" hidden/>
<section class="sw25v2 sw25v2-pc {{#if (eq sw25Theme "dark")}}theme-dark{{/if}} {{#if equipCard.open}}has-equipcard{{/if}}">
{{#if equipCard.open}}{{> "systems/sw25-ce/templates/actor/parts/actor-equipcard.hbs"}}{{/if}}
<div class="eqc-main">

  <header class="v2-header">
    <div class="portrait">
      {{#if system.isToken}}
      <img class="profile-img" src="{{#if token.texture.src}}{{token.texture.src}}{{else}}{{actor.prototypeToken.texture.src}}{{/if}}" title="{{actor.name}}"/>
      {{else}}
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
      {{/if}}
    </div>
    <div class="v2-id">
      <div class="v2-titlerow">
        <h1>{{#if system.isEdit}}<input name="name" type="text" value="{{actor.name}}" placeholder="Name"/>{{else}}{{actor.name}}{{/if}}</h1>
        <div class="v2-toggles">
          {{#if system.isEdit}}
          <label class="tog" data-tooltip="{{#if system.isToken}}{{localize "SW25.SwitchImage" image=(localize "SW25.ActorImage")}}{{else}}{{localize "SW25.SwitchImage" image=(localize "SW25.TokenImage")}}{{/if}}"><input type="checkbox" name="system.isToken" {{#if system.isToken}}checked{{/if}} data-dtype="Boolean"/><i class="fa-solid fa-circle-user"></i></label>
          {{/if}}
          <label class="tog" data-tooltip="{{localize "SW25.Fellow"}}"><input type="checkbox" name="system.toFellow" {{#if system.toFellow}}checked{{/if}} data-dtype="Boolean"/><i class="fa-solid fa-people-group"></i></label>
          <label class="tog" data-tooltip="{{localize "SW25.Attributes.Grace"}}"><input type="checkbox" name="system.attributes.grace" {{#if system.attributes.grace}}checked{{/if}} data-dtype="Boolean"/><i class="fa-solid fa-chess-queen"></i></label>
          <label class="tog edit" data-tooltip="{{localize "SW25.V2.EditMode"}}"><input type="checkbox" name="system.isEdit" {{#if system.isEdit}}checked{{/if}} data-dtype="Boolean"/><i class="fa-solid fa-wrench"></i></label>
        </div>
      </div>
      <div class="meta">
        {{#if system.isEdit}}
        <label>{{localize "SW25.Race"}} <input type="text" name="system.race" value="{{system.race}}" data-dtype="String"/></label>
        <label>{{localize "SW25.Attributes.Gender"}} <input type="text" name="system.attributes.gender" value="{{system.attributes.gender}}" data-dtype="String"/></label>
        <label>{{localize "SW25.Attributes.Age"}} <input type="number" name="system.attributes.age" value="{{system.attributes.age}}" data-dtype="Number"/></label>
        <label>{{localize "SW25.Attributes.Honer.Rank"}} <input type="text" name="system.attributes.honer.rank" value="{{system.attributes.honer.rank}}" data-dtype="String"/></label>
        <label>{{localize "SW25.Attributes.Honer.Label"}} <input type="number" name="system.attributes.honer.value" value="{{system.attributes.honer.value}}" data-dtype="Number"/></label>
        {{else}}
        <span>{{localize "SW25.Race"}} <b>{{system.race}}</b></span>
        {{#if system.attributes.gender}}<span><b>{{system.attributes.gender}}</b></span>{{/if}}
        {{#if system.attributes.age}}<span>{{localize "SW25.Attributes.Age"}} <b>{{system.attributes.age}}</b></span>{{/if}}
        <span data-tooltip="{{localize 'SW25.V2.Tip.Honour'}}"><i class="fa-solid fa-medal"></i> <b>{{system.attributes.honer.rank}}</b> / {{system.attributes.honer.value}}</span>
        {{/if}}
        <span data-tooltip="{{localize 'SW25.V2.Tip.AdvLevel'}}">{{localize "SW25.V2.AdvLevel"}} <b class="big">{{system.attributes.advlevel.value}}</b></span>
        <span data-tooltip="{{localize 'SW25.V2.Tip.Exp'}}">{{localize "SW25.V2.Exp"}} <b>{{system.attributes.useexp}}</b> / {{system.attributes.totalexp}}</span>
      </div>
      <div class="bars">
        {{#unless system.toFellow}}
        <div class="bar hp" data-tooltip="{{localize 'SW25.V2.Tip.HP'}}">
          <i style="width:{{sw25pct system.hp.value system.hp.max}}%"></i>
          <span><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/hp.svg)"></span> {{localize "SW25.V2.HP"}}
          {{#if system.isEdit}}{{system.hp.max}} + <input type="number" name="system.hp.hpmod" value="{{system.hp.hpmod}}" data-dtype="Number" data-tooltip="{{localize 'SW25.V2.Tip.MaxMod'}}"/>
          {{else}}<input type="number" name="system.hp.value" value="{{system.hp.value}}" data-dtype="Number"/> / {{system.hp.max}}{{/if}}</span>
        </div>
        {{/unless}}
        <div class="bar mp" data-tooltip="{{localize 'SW25.V2.Tip.MP'}}">
          <i style="width:{{sw25pct system.mp.value system.mp.max}}%"></i>
          <span><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/mp.svg)"></span> {{localize "SW25.V2.MP"}}
          {{#if system.isEdit}}{{system.mp.max}} + <input type="number" name="system.mp.mpmod" value="{{system.mp.mpmod}}" data-dtype="Number" data-tooltip="{{localize 'SW25.V2.Tip.MaxMod'}}"/>
          {{else}}<input type="number" name="system.mp.value" value="{{system.mp.value}}" data-dtype="Number"/> / {{system.mp.max}}{{/if}}</span>
        </div>
        {{#if system.toFellow}}<div class="roll-actiontable action-button chip"><i class="fas fa-dice-d6"></i> {{localize "SW25.ActionRoll"}}</div>{{/if}}
      </div>
    </div>
  </header>

  {{#unless system.toFellow}}
  <div class="panel abilities">
    <span class="ribbon">{{localize "SW25.V2.Abilities"}}</span>
    <div class="abil">
      {{#with system.abilities.dex as |ab|}}
      <div class="ab" data-tooltip="{{localize 'SW25.V2.Tip.AbDex'}}">
        <span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/dex.svg)"></span>
        <div class="n">{{localize "SW25.Ability.Dex.long"}}</div>
        <div class="v">{{ab.value}}</div>
        <div class="b">{{numberFormat ab.mod decimals=0 sign=true}}</div>
        {{#if ../system.isEdit}}
        <div class="ab-edit">
          <label data-tooltip="{{localize 'SW25.V2.Tip.Base'}}">{{localize "SW25.Ability.Technique"}}<input type="number" name="system.abilities.dex.racevalue" value="{{ab.racevalue}}" data-dtype="Number"/></label>
          
          <label data-tooltip="{{localize 'SW25.V2.Tip.Roll'}}">{{ab.basename}}<input type="number" name="system.abilities.dex.valuebase" value="{{ab.valuebase}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Growth'}}">{{growth 0}}<input type="number" name="system.abilities.dex.valuegrowth" value="{{ab.valuegrowth}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">{{localize "SW25.Ability.Modify"}}<input type="number" name="system.abilities.dex.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        </div>
        {{else}}
        <div class="bd">{{localize "SW25.Ability.Technique"}} {{ab.racevalue}} + {{ab.basename}} {{ab.valuebase}} + {{growth 0}} {{ab.valuegrowth}}</div>
        <label class="modf" data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">± <input type="number" name="system.abilities.dex.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        {{/if}}
      </div>
      {{/with}}
      {{#with system.abilities.agi as |ab|}}
      <div class="ab" data-tooltip="{{localize 'SW25.V2.Tip.AbAgi'}}">
        <span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/agi.svg)"></span>
        <div class="n">{{localize "SW25.Ability.Agi.long"}}</div>
        <div class="v">{{ab.value}}</div>
        <div class="b">{{numberFormat ab.mod decimals=0 sign=true}}</div>
        {{#if ../system.isEdit}}
        <div class="ab-edit">
          
          <label class="dim" data-tooltip="{{localize 'SW25.V2.Tip.Base'}}">{{localize "SW25.Ability.Technique"}}<span>{{ab.racevalue}}</span></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Roll'}}">{{ab.basename}}<input type="number" name="system.abilities.agi.valuebase" value="{{ab.valuebase}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Growth'}}">{{growth 1}}<input type="number" name="system.abilities.agi.valuegrowth" value="{{ab.valuegrowth}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">{{localize "SW25.Ability.Modify"}}<input type="number" name="system.abilities.agi.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        </div>
        {{else}}
        <div class="bd">{{localize "SW25.Ability.Technique"}} {{ab.racevalue}} + {{ab.basename}} {{ab.valuebase}} + {{growth 1}} {{ab.valuegrowth}}</div>
        <label class="modf" data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">± <input type="number" name="system.abilities.agi.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        {{/if}}
      </div>
      {{/with}}
      {{#with system.abilities.str as |ab|}}
      <div class="ab" data-tooltip="{{localize 'SW25.V2.Tip.AbStr'}}">
        <span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/str.svg)"></span>
        <div class="n">{{localize "SW25.Ability.Str.long"}}</div>
        <div class="v">{{ab.value}}</div>
        <div class="b">{{numberFormat ab.mod decimals=0 sign=true}}</div>
        {{#if ../system.isEdit}}
        <div class="ab-edit">
          <label data-tooltip="{{localize 'SW25.V2.Tip.Base'}}">{{localize "SW25.Ability.Body"}}<input type="number" name="system.abilities.str.racevalue" value="{{ab.racevalue}}" data-dtype="Number"/></label>
          
          <label data-tooltip="{{localize 'SW25.V2.Tip.Roll'}}">{{ab.basename}}<input type="number" name="system.abilities.str.valuebase" value="{{ab.valuebase}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Growth'}}">{{growth 2}}<input type="number" name="system.abilities.str.valuegrowth" value="{{ab.valuegrowth}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">{{localize "SW25.Ability.Modify"}}<input type="number" name="system.abilities.str.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        </div>
        {{else}}
        <div class="bd">{{localize "SW25.Ability.Body"}} {{ab.racevalue}} + {{ab.basename}} {{ab.valuebase}} + {{growth 2}} {{ab.valuegrowth}}</div>
        <label class="modf" data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">± <input type="number" name="system.abilities.str.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        {{/if}}
      </div>
      {{/with}}
      {{#with system.abilities.vit as |ab|}}
      <div class="ab" data-tooltip="{{localize 'SW25.V2.Tip.AbVit'}}">
        <span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/vit.svg)"></span>
        <div class="n">{{localize "SW25.Ability.Vit.long"}}</div>
        <div class="v">{{ab.value}}</div>
        <div class="b">{{numberFormat ab.mod decimals=0 sign=true}}</div>
        {{#if ../system.isEdit}}
        <div class="ab-edit">
          
          <label class="dim" data-tooltip="{{localize 'SW25.V2.Tip.Base'}}">{{localize "SW25.Ability.Body"}}<span>{{ab.racevalue}}</span></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Roll'}}">{{ab.basename}}<input type="number" name="system.abilities.vit.valuebase" value="{{ab.valuebase}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Growth'}}">{{growth 3}}<input type="number" name="system.abilities.vit.valuegrowth" value="{{ab.valuegrowth}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">{{localize "SW25.Ability.Modify"}}<input type="number" name="system.abilities.vit.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        </div>
        {{else}}
        <div class="bd">{{localize "SW25.Ability.Body"}} {{ab.racevalue}} + {{ab.basename}} {{ab.valuebase}} + {{growth 3}} {{ab.valuegrowth}}</div>
        <label class="modf" data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">± <input type="number" name="system.abilities.vit.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        {{/if}}
      </div>
      {{/with}}
      {{#with system.abilities.int as |ab|}}
      <div class="ab" data-tooltip="{{localize 'SW25.V2.Tip.AbInt'}}">
        <span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/int.svg)"></span>
        <div class="n">{{localize "SW25.Ability.Int.long"}}</div>
        <div class="v">{{ab.value}}</div>
        <div class="b">{{numberFormat ab.mod decimals=0 sign=true}}</div>
        {{#if ../system.isEdit}}
        <div class="ab-edit">
          <label data-tooltip="{{localize 'SW25.V2.Tip.Base'}}">{{localize "SW25.Ability.Heart"}}<input type="number" name="system.abilities.int.racevalue" value="{{ab.racevalue}}" data-dtype="Number"/></label>
          
          <label data-tooltip="{{localize 'SW25.V2.Tip.Roll'}}">{{ab.basename}}<input type="number" name="system.abilities.int.valuebase" value="{{ab.valuebase}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Growth'}}">{{growth 4}}<input type="number" name="system.abilities.int.valuegrowth" value="{{ab.valuegrowth}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">{{localize "SW25.Ability.Modify"}}<input type="number" name="system.abilities.int.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        </div>
        {{else}}
        <div class="bd">{{localize "SW25.Ability.Heart"}} {{ab.racevalue}} + {{ab.basename}} {{ab.valuebase}} + {{growth 4}} {{ab.valuegrowth}}</div>
        <label class="modf" data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">± <input type="number" name="system.abilities.int.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        {{/if}}
      </div>
      {{/with}}
      {{#with system.abilities.mnd as |ab|}}
      <div class="ab" data-tooltip="{{localize 'SW25.V2.Tip.AbMnd'}}">
        <span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/mnd.svg)"></span>
        <div class="n">{{localize "SW25.Ability.Mnd.long"}}</div>
        <div class="v">{{ab.value}}</div>
        <div class="b">{{numberFormat ab.mod decimals=0 sign=true}}</div>
        {{#if ../system.isEdit}}
        <div class="ab-edit">
          
          <label class="dim" data-tooltip="{{localize 'SW25.V2.Tip.Base'}}">{{localize "SW25.Ability.Heart"}}<span>{{ab.racevalue}}</span></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Roll'}}">{{ab.basename}}<input type="number" name="system.abilities.mnd.valuebase" value="{{ab.valuebase}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Growth'}}">{{growth 5}}<input type="number" name="system.abilities.mnd.valuegrowth" value="{{ab.valuegrowth}}" data-dtype="Number"/></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">{{localize "SW25.Ability.Modify"}}<input type="number" name="system.abilities.mnd.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        </div>
        {{else}}
        <div class="bd">{{localize "SW25.Ability.Heart"}} {{ab.racevalue}} + {{ab.basename}} {{ab.valuebase}} + {{growth 5}} {{ab.valuegrowth}}</div>
        <label class="modf" data-tooltip="{{localize 'SW25.V2.Tip.Modify'}}">± <input type="number" name="system.abilities.mnd.valuemodify" value="{{ab.valuemodify}}" data-dtype="Number"/></label>
        {{/if}}
      </div>
      {{/with}}
    </div>
    <div class="base">
      <span class="roll-ability-check growth-button chip" data-tooltip="{{localize 'SW25.V2.Tip.GrowthRoll'}}"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/growth.svg)"></span> {{localize "SW25.V2.GrowthRoll"}}</span>
    </div>
  </div>

  <nav class="v2-tabs sheet-tabs" data-group="primary">
    <a class="item" data-tab="combat"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/combatability.svg)"></span> {{localize "SW25.V2.TabCombat"}}</a>
    <a class="item" data-tab="classes"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/fighter.svg)"></span> {{localize "SW25.V2.TabClasses"}}</a>
    <a class="item" data-tab="magic"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/spell.svg)"></span> {{localize "SW25.V2.TabMagic"}}</a>
    <a class="item" data-tab="inventory"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/item.svg)"></span> {{localize "SW25.V2.TabInventory"}}</a>
    <a class="item" data-tab="effects"><i class="fa-solid fa-hand-sparkles"></i> {{localize "SW25.V2.TabEffects"}}</a>
    <a class="item" data-tab="bio"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/truespeech.svg)"></span> {{localize "SW25.V2.TabBio"}}</a>
  </nav>

  <section class="sheet-body v2-body">

    <div class="tab combat" data-group="primary" data-tab="combat">
      {{> "systems/sw25-ce/templates/actor/parts/actor-ce7-wallet.hbs"}}
      <div class="panel">
        <span class="ribbon">{{localize "SW25.V2.Combat"}}</span>
        <div class="combat">
          <div class="stat rollable" data-needweapon data-resusequantity={{system.resusequantity}} data-resuse="{{system.resuse}}" data-roll="{{system.itemhitformula}}+{{system.itemhitbase}}" data-label="{{system.itemname}} ({{localize "SW25.Item.Weapon.Hit"}})" data-pt="{{system.itempowertable}}" data-apply="{{system.itemapplycheck}}" data-checktype="{{system.itemchecktype}}" data-resist="{{localize "SW25.Resist.Check.Dodge"}}" data-resistresult="disappear" data-tooltip="{{localize 'SW25.V2.Tip.Accuracy'}}"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/accuracy.svg)"></span><div class="v">{{system.itemhitbase}}</div><div class="n">{{localize "SW25.V2.Accuracy"}}</div></div>
          <div class="stat powerrollable" data-needweapon data-roll="{{system.itempowerformula}}" data-label="{{system.itemname}} ({{localize "SW25.Item.Power"}})" data-pt="{{system.itempowertable}}" data-apply="{{system.itemapplypower}}" data-powertype="{{system.itempowertype}}" data-itemid="{{system.itemid}}" data-tooltip="{{localize 'SW25.V2.Tip.Damage'}}"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/damage.svg)"></span><div class="v sm">{{sw25dmg system.itempower system.itemcvalue system.itempowerbase}}</div><div class="n">{{localize "SW25.V2.DamagePCB"}}</div></div>
          <div class="stat rollable" data-selfcheck data-roll="2d6+{{system.dodgebase}}" data-label="{{localize "SW25.Item.Armor.Dodge"}}" data-pt="" data-tooltip="{{localize 'SW25.V2.Tip.Evasion'}}"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/evasion.svg)"></span><div class="v">{{system.dodgebase}}</div><div class="n">{{localize "SW25.V2.Evasion"}}</div></div>
          <div class="stat" data-tooltip="{{localize 'SW25.V2.Tip.Defense'}}"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/defense.svg)"></span><div class="v">{{system.attributes.protectionpoint}}</div><div class="n">{{localize "SW25.V2.Defense"}}{{#if system.baredreduce}} ({{system.barepp}}+{{system.baredreduce}}){{/if}}</div></div>
          <div class="stat" data-tooltip="{{localize 'SW25.V2.Tip.MagicDefense'}}"><i class="fa-solid fa-star-of-david"></i><div class="v">{{system.attributes.magicprotection}}</div><div class="n">{{localize "SW25.V2.MagicDefense"}}{{#if system.baredreduce}} ({{system.barempp}}+{{system.baredreduce}}){{/if}}</div></div>
          {{#if contentItem.vitRes}}{{#with contentItem.vitRes as |item|}}
          <div class="stat item" data-item-id="{{item._id}}" data-tooltip="{{localize 'SW25.V2.Tip.Fortitude'}}">
            <span class="rollable" data-selfcheck data-roll="{{item.system.formula}}+{{item.system.checkbase}}" data-label="{{item.name}}" data-pt="{{item.system.powertable}}" data-apply="{{item.system.applycheck}}" data-checktype="{{item.system.checkTypesButton}}"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/vit.svg)"></span><div class="v">{{item.system.checkbase}}</div><div class="n">{{localize "SW25.V2.Fortitude"}}</div></span>
            <input class="cm-change mini" type="text" name="checkmodInput" value="{{item.system.checkmod}}" data-dtype="Number" data-tooltip="{{localize 'SW25.Modifier'}}"/>
          </div>{{/with}}{{else}}
          <div class="stat" data-tooltip="{{localize 'SW25.V2.Tip.Fortitude'}}"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/vit.svg)"></span><div class="v">–</div><div class="n">{{localize "SW25.V2.Fortitude"}}</div></div>{{/if}}
          {{#if contentItem.mndRes}}{{#with contentItem.mndRes as |item|}}
          <div class="stat item" data-item-id="{{item._id}}" data-tooltip="{{localize 'SW25.V2.Tip.Willpower'}}">
            <span class="rollable" data-selfcheck data-roll="{{item.system.formula}}+{{item.system.checkbase}}" data-label="{{item.name}}" data-pt="{{item.system.powertable}}" data-apply="{{item.system.applycheck}}" data-checktype="{{item.system.checkTypesButton}}"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/mnd.svg)"></span><div class="v">{{item.system.checkbase}}</div><div class="n">{{localize "SW25.V2.Willpower"}}</div></span>
            <input class="cm-change mini" type="text" name="checkmodInput" value="{{item.system.checkmod}}" data-dtype="Number" data-tooltip="{{localize 'SW25.Modifier'}}"/>
          </div>{{/with}}{{else}}
          <div class="stat" data-tooltip="{{localize 'SW25.V2.Tip.Willpower'}}"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/mnd.svg)"></span><div class="v">–</div><div class="n">{{localize "SW25.V2.Willpower"}}</div></div>{{/if}}
          <div class="stat" data-tooltip="{{localize 'SW25.V2.Tip.Move'}}"><i class="fa-solid fa-person-running"></i><div class="v sm">{{system.attributes.move.limited}} / {{system.attributes.move.normal}} / {{system.attributes.move.max}}</div><div class="n">{{localize "SW25.V2.Move"}}</div></div>
        </div>
        <div class="selects">
          <label data-tooltip="{{localize 'SW25.V2.Tip.HitWeapon'}}"><i class="mgc_knife_fill"></i><select name="system.hitweapon"><option value="-">{{localize "SW25.Selecthitweapon"}}</option>{{selectOptions battleweapons selected=system.itemid valueAttr="_id" labelAttr="name"}}</select></label>
          <label data-tooltip="{{localize 'SW25.V2.Tip.AttackSkill'}}"><i class="fa-solid fa-bullseye"></i><select name="system.attackskill"><option value="-">{{localize "SW25.Selectattackskill"}}</option>{{selectOptions skills selected=system.attackskill valueAttr="name" labelAttr="name"}}</select></label>
