          <label class="mod" data-tooltip="{{localize 'SW25.V2.Tip.SchoolMod'}}"><i class="fa-solid fa-angles-up"></i><input type="text" name="system.attributes.bmmod" value="{{system.attributes.bmmod}}" data-dtype="Number"/></label>
        </div>
        <div class="spelllist-description">{{> "systems/sw25-ce/templates/actor/parts/actor-spells-bibliomancer.hbs"}}</div>
      </div>
      {{/if}}
      <label class="showtoggle"><input type="checkbox" name="system.attributes.showspell" data-dtype="Boolean" {{#if system.attributes.showspell}}checked{{/if}}/> {{localize "SW25.Attributes.Showspell"}}</label>
      {{#if system.attributes.showspell}}<div class="panel">{{> "systems/sw25-ce/templates/actor/parts/actor-spells.hbs"}}</div>{{/if}}
    </div>

    <div class="tab inventory" data-group="primary" data-tab="inventory">
      <div class="money" data-tooltip="{{localize 'SW25.V2.Tip.Money'}}"><i class="fa-solid fa-coins"></i> {{localize "SW25.Mymoney"}} <b>{{system.money}}</b> G <span class="muted">({{localize "SW25.V2.Deposit"}} {{system.deposit}} G · {{localize "SW25.V2.Debt"}} {{system.debt}} G)</span></div>
      <div class="panel"><span class="ribbon"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/item.svg)"></span> {{localize "SW25.V2.Items"}}</span>{{> "systems/sw25-ce/templates/actor/parts/actor-items.hbs"}}</div>
      <div class="panel"><span class="ribbon"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/weapon.svg)"></span> {{localize "SW25.V2.Weapons"}}</span>{{> "systems/sw25-ce/templates/actor/parts/actor-weapons.hbs"}}</div>
      <div class="panel"><span class="ribbon"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/armor.svg)"></span> {{localize "SW25.V2.Armour"}}</span>{{> "systems/sw25-ce/templates/actor/parts/actor-armors.hbs"}}</div>
      <div class="panel"><span class="ribbon"><span class="ico" style="--i:url(/systems/sw25-ce/assets/icons/accessory.svg)"></span> {{localize "SW25.V2.Accessories"}}</span>{{> "systems/sw25-ce/templates/actor/parts/actor-accessories.hbs"}}</div>
    </div>

    <div class="tab effects" data-group="primary" data-tab="effects">
      <div class="panel"><span class="ribbon">{{localize "SW25.Effect.TotalEffects"}}</span>
        <div class="effgrid">{{#each system.modParams}}<div>{{label}}: <b>{{value}}</b></div>{{/each}}</div>
      </div>
      <div class="panel">{{> "systems/sw25-ce/templates/actor/parts/actor-effects.hbs"}}</div>
    </div>

    <div class="tab bio" data-group="primary" data-tab="bio">
      <div class="grid2">
        <div class="panel"><span class="ribbon">{{localize "SW25.Languages"}}</span>{{> "systems/sw25-ce/templates/actor/parts/actor-languages.hbs"}}</div>
        <div class="panel"><span class="ribbon">{{localize "SW25.V2.Details"}}</span>
          <div class="kv">
            <label>{{localize "SW25.Attributes.Born"}}<input type="text" name="system.attributes.born" value="{{system.attributes.born}}" data-dtype="String"{{#unless system.isEdit}} disabled{{/unless}}/></label>
            <label>{{localize "SW25.Attributes.Faith"}}<input type="text" name="system.attributes.faith" value="{{system.attributes.faith}}" data-dtype="String"{{#unless system.isEdit}} disabled{{/unless}}/></label>
            <label>{{localize "SW25.Actor.Type"}}<select name="system.classType"{{#unless system.isEdit}} disabled{{/unless}}>{{selectOptions config.actorClasses selected=system.classType localize=true blank="SW25.Item.None"}}</select></label>
            <label data-tooltip="{{localize 'SW25.V2.Tip.Impurity'}}">{{localize "SW25.Attributes.Impurity"}}<span class="adj">
              <a class="adjustment-button" data-action="decrease" data-property="system.attributes.impurity"><i class="fas fa-minus"></i></a>
              <input type="number" name="system.attributes.impurity" value="{{system.attributes.impurity}}" data-dtype="Number"{{#unless system.isEdit}} disabled{{/unless}}/>
              <a class="adjustment-button" data-action="increase" data-property="system.attributes.impurity"><i class="fas fa-plus"></i></a></span></label>
          </div>
          <details class="advanced" data-sw25-adv="bio" {{#if sw25Adv.bio}}open{{/if}}>
            <summary>{{localize "SW25.Defaultitemskill"}} &amp; {{localize "SW25.Actor.ColorSetting.Title"}}</summary>
            <div class="kv">
              <label><i class="fa-solid fa-leaf"></i> {{localize "SW25.Selectherbskill"}}<select name="system.herbskill">{{selectOptions skills selected=system.herbskill valueAttr="name" labelAttr="name" blank="-"}}</select></label>
              <label><i class="fa-solid fa-flask"></i> {{localize "SW25.Selectpotionskill"}}<select name="system.potionskill">{{selectOptions skills selected=system.potionskill valueAttr="name" labelAttr="name" blank="-"}}</select></label>
              <label><i class="fa-solid fa-screwdriver-wrench"></i> {{localize "SW25.Selectrepairskill"}}<select name="system.repairskill">{{selectOptions skills selected=system.repairskill valueAttr="name" labelAttr="name" blank="-"}}</select></label>
              {{#if system.isEdit}}
              <label>{{localize "SW25.Actor.ColorSetting.Main"}} {{localize "SW25.Actor.ColorSetting.Background"}}<input type="color" name="system.color.main.bg" value="{{system.color.main.bg}}"/></label>
              <label>{{localize "SW25.Actor.ColorSetting.Main"}} {{localize "SW25.Actor.ColorSetting.Text"}}<input type="color" name="system.color.main.text" value="{{system.color.main.text}}"/></label>
              <label>{{localize "SW25.Actor.ColorSetting.Sub"}} {{localize "SW25.Actor.ColorSetting.Background"}}<input type="color" name="system.color.sub.bg" value="{{system.color.sub.bg}}"/></label>
              <label>{{localize "SW25.Actor.ColorSetting.Sub"}} {{localize "SW25.Actor.ColorSetting.Text"}}<input type="color" name="system.color.sub.text" value="{{system.color.sub.text}}"/></label>
              <p class="hint">{{localize "SW25.V2.ColorHint"}}</p>
              {{/if}}
            </div>
          </details>
        </div>
      </div>
      <div class="panel bio-editor"><span class="ribbon">{{localize "SW25.Biography"}}</span>
        {{editor system.biography target="system.biography" rollData=rollData button=true owner=owner editable=editable}}
      </div>
    </div>
  </section>
  {{/unless}}

  {{#if system.toFellow}}
    <nav class="v2-tabs sheet-tabs" data-group="primary">
    <a class="item" data-tab="fellowAction">{{localize "SW25.ActionTable"}}</a>
    <a class="item" data-tab="fellowSetting">{{localize "SW25.Setting"}}</a>
  </nav>

  {{!-- Fellow Sheet Body --}}
  <section class="sheet-body v2-body">

    {{!-- Fellow Action Tab --}}
    <div class="tab fellowAction flexcol" data-group="primary" data-tab="fellowAction">
      {{#if (eq system.tabletype "fellow")}}
      <div class="flexcol margin-s">
        <div>
          {{> "systems/sw25-ce/templates/actor/parts/actor-actions-fellow.hbs"}}
        </div>
      </div>
      {{/if}}
      {{#if (eq system.tabletype "daemon")}}
      <div class="flexcol margin-s">
        <div>
          {{> "systems/sw25-ce/templates/actor/parts/actor-actions-daemon.hbs"}}
        </div>
      </div>
      {{/if}}
      <div class="margin-m" style="display: flex; align-items: center;">
        <input type="checkbox" id="{{actor._id}}system.attributes.showaction" name="system.attributes.showaction" data-dtype="Boolean" {{#if system.attributes.showaction}} checked {{/if}}/>
        <label for="{{actor._id}}system.attributes.showaction">{{localize "SW25.Attributes.Showaction"}}</label>
      </div>
      {{#if system.attributes.showaction}}
      <div class="flexcol margin-s">
        <div>
          {{> "systems/sw25-ce/templates/actor/parts/actor-actions.hbs"}}
        </div>
      </div>
      {{/if}}
    </div>

    {{!-- Fellow Setting Tab --}}
    <div class="tab fellowSetting flexcol" data-group="primary" data-tab="fellowSetting">
      <div class="grid grid-10col margin-s">
        <div class="grid-span-4 property">
          <label class="property--label">{{localize "SW25.Item.Action.TableType"}}</label>
          <select class="property--value" name="system.tabletype"{{#unless system.isEdit}} disabled{{/unless}}>
            {{selectOptions config.fellowTypes selected=system.tabletype localize=true}}
          </select>
        </div>
        <span class="grid-span-2"></span>
        <div class="grid-span-2 property">
          <input class="checkbox--hidden" id="{{actor._id}}fellowexp" type="checkbox" name="system.attributes.fellowexp" {{#if system.attributes.fellowexp}}checked{{/if}} data-dtype="Boolean"{{#unless system.isEdit}} disabled{{/unless}}/>
          <label class="checkbox--label" for="{{actor._id}}fellowexp">{{localize "SW25.Attributes.Exp"}}</label>
        </div>
        <div class="grid-span-2 property">
          <input class="checkbox--hidden" id="{{actor._id}}fellowreward" type="checkbox" name="system.attributes.fellowreward" {{#if system.attributes.fellowreward}}checked{{/if}} data-dtype="Boolean"{{#unless system.isEdit}} disabled{{/unless}}/>
          <label class="checkbox--label" for="{{actor._id}}fellowreward">{{localize "SW25.Reward"}}</label>
        </div>
        <div class="grid-span-10 property">
          <label class="property--label" for="{{actor._id}}system.canceldialog">{{localize "SW25.CancelDialog"}}</label>
          <input class="property--value" id="{{actor._id}}system.canceldialog" type="text" name="system.canceldialog" value="{{system.canceldialog}}" data-dtype="String"{{#unless system.isEdit}} disabled{{/unless}}/>
        </div>
      </div>

      <hr>
      {{#if system.toFellow}}
      <div class="character-details-secondary textalign-center">
      </div>
      <hr>
      <div class="textalign-left">
        <div class="detail__fellowlanglabel">
          <span for="{{actor._id}}fellowlang" class="resource-label">{{localize "SW25.Languages"}}:</span>
        </div>
        <div class="detail__fellowlang">
          <span class="langlist">{{system.attributes.langlist}}</span>
        </div>
      </div>
      <hr>
      <div class="textalign-left">
        <div class="detail__fellowmemolabel">
          <span for="{{actor._id}}fellowmemo" class="resource-label">{{localize "SW25.Fellowmemo"}}:</span>
        </div>
        <div class="detail__fellowmemo">
          <textarea id="{{actor._id}}fellowmemo" class="textarea-editor" type="text" name="system.fellowmemo" placeholder="Memo" style="width: 100%; height: 40px;"{{#unless system.isEdit}} disabled{{/unless}}>{{system.fellowmemo}}</textarea>
        </div>
      </div>
      {{/if}}
    </div>

  </section>
  {{/if}}

  <footer class="footer v2-footer">
    <button type="button" class="scroll-button left">◀</button>
    <section class="bookmark-container bookmark-drop-area" id="bookmark-outer">
      <div id="bookmark-inner"><ul class="bookmarks">
      {{#each bookmarks as |item id|}}
        {{> "systems/sw25-ce/templates/actor/parts/actor-bookmark-item.hbs" item=item}}
      {{/each}}
      <li class="bookmarks--overview">{{localize "SW25.AddBookmark"}}</li>
      </ul></div>
    </section>
    <button type="button" class="scroll-button right">▶</button>
  </footer>
</div>{{!-- /eqc-main --}}
</section>
</form>
