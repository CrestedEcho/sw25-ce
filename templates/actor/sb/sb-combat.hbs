<div class="sb-grid">
  <div class="f"><label>Reputation / Weakness</label>{{> "systems/sw25-ce/templates/actor/sb/sb-num.hbs" n=stats.reputation}} / {{> "systems/sw25-ce/templates/actor/sb/sb-num.hbs" n=stats.weakness}}</div>
  <div class="f w2"><label>Weak point</label><input class="sb-in" type="text" name="system.sb.weakPoint" value="{{sb.weakPoint}}"></div>
  <div class="f"><label title="GM: set automatically when a PC Monster Knowledge check meets the Weakness number">Weakness revealed</label><input type="checkbox" name="system.sb.weaknessRevealed" data-dtype="Boolean" {{#if sb.weaknessRevealed}}checked{{/if}}> <small>{{#if sb.reputationReached}}(reputation reached){{/if}}</small></div>
  <div class="f"><label>Initiative</label>{{> "systems/sw25-ce/templates/actor/sb/sb-num.hbs" n=stats.initiative}}</div>
  <div class="f"><label>Movement</label>{{> "systems/sw25-ce/templates/actor/sb/sb-num.hbs" n=stats.moveGround}} / {{> "systems/sw25-ce/templates/actor/sb/sb-num.hbs" n=stats.moveOther}}</div>
  <div class="f"><label>Fortitude</label>{{> "systems/sw25-ce/templates/actor/sb/sb-pair.hbs" p=stats.fortitude}}</div>
  <div class="f"><label>Willpower</label>{{> "systems/sw25-ce/templates/actor/sb/sb-pair.hbs" p=stats.willpower}}</div>
  <div class="f"><label>Use fixed values</label><input type="checkbox" name="system.sb.useFixed" {{checked sb.useFixed}}></div>
  {{#if isNPC}}
  {{#if hostile}}{{#if showIntel}}<div class="f"><label>Intellect</label><span>{{sb.intelligence}}</span></div>{{/if}}{{#if showPerception}}<div class="f"><label>Perception</label><span>{{sb.perception}}</span></div>{{/if}}{{/if}}
  {{/if}}
  {{#if showSections}}<div class="f"><label>Sections / Main</label><span>{{sb.partCount}} / {{sb.coreParts}}</span></div>{{/if}}
</div>
<div class="sb-parts-wrap"><h3>Parts {{#if editable}}<a class="sb-add" data-action="add" data-field="parts" title="Add part"><i class="fas fa-plus"></i></a>{{/if}}</h3>
<table class="sb-table sb-parts"><thead><tr><th>Part / style</th><th>×</th><th>Accuracy</th><th>Damage</th><th>Evasion</th><th>Defense</th><th>HP</th><th>MP</th><th></th></tr></thead><tbody>
{{#each parts}}<tr class="{{#if dead}}is-dead{{/if}}">
  <td><input class="sb-in w-name" type="text" name="system.sb.parts.{{i}}.name" value="{{name}}"><a data-action="core" data-index="{{i}}" class="sb-core{{#if isCore}} on{{/if}}" title="Main section">★</a></td>
  <td><input class="sb-in w-xs" type="text" name="system.sb.parts.{{i}}.count" value="{{count}}" data-dtype="Number"></td>
  <td>{{> "systems/sw25-ce/templates/actor/sb/sb-pair.hbs" p=accuracy}}</td>
  <td><input class="sb-in w-dice" type="text" name="system.sb.parts.{{i}}.damage" value="{{damage}}"></td>
  <td>{{> "systems/sw25-ce/templates/actor/sb/sb-pair.hbs" p=evasion}}</td>
  <td>{{> "systems/sw25-ce/templates/actor/sb/sb-num.hbs" n=defense}}</td>
  <td><input class="sb-in w-xs" type="text" name="system.sb.parts.{{i}}.hpValue" value="{{hpValue}}" data-dtype="Number">/{{> "systems/sw25-ce/templates/actor/sb/sb-num.hbs" n=hp}}</td>
  <td><input class="sb-in w-xs" type="text" name="system.sb.parts.{{i}}.mpValue" value="{{mpValue}}" data-dtype="Number">/{{> "systems/sw25-ce/templates/actor/sb/sb-num.hbs" n=mp}}</td>
  <td>{{#if @root.editable}}<a class="sb-del" data-action="del" data-field="parts" data-index="{{i}}"><i class="fas fa-times"></i></a>{{/if}}</td>
</tr>{{else}}<tr><td colspan="9" class="muted">No parts — add one.</td></tr>{{/each}}
</tbody></table></div>
<h3>Unique skills {{#if editable}}<a class="sb-add" data-action="skill-edit" data-index="-1" title="New Unique Skill"><i class="fas fa-plus"></i></a>{{/if}}</h3>
{{#each skills}}{{#unless (and inMagic @root.playMode)}}<div class="sb-skill">
  <div class="sb-sk-line">
    <span class="sb-sk-tags">{{#each tags}}{{#if icon}}<img class="sb-tag" src="{{icon}}" alt="{{glyph}}" title="{{tip}}" data-tooltip="{{tip}}">{{else}}<span class="sb-glyph" title="{{tip}}">{{glyph}}</span>{{/if}}{{/each}}</span>
    {{#if @root.editable}}<a class="sb-sk-name" data-action="skill-edit" data-index="{{i}}" title="Edit skill">{{name}}</a>{{else}}<b class="sb-sk-name">{{name}}</b>{{/if}}{{#if part}} <span class="sb-sk-part">{{part}}</span>{{/if}}{{#if inMagic}} <small class="sb-moved" title="{{localize 'SW25.SB.MovedHint'}}">→ {{localize "SW25.SB.Magic"}}</small>{{/if}}
    {{#if check}}<small class="sb-sk-check">Check {{check}}{{#if resist}} · {{resist}}{{/if}}</small>{{else}}{{#if resist}}<small class="sb-sk-check">{{resist}}</small>{{/if}}{{/if}}
    <span class="sb-sk-acts">
      <a class="sb-btn sb-sk-post" data-action="sb-skill-post" data-index="{{i}}" title="Post this skill to chat"><i class="fas fa-comment"></i> Post</a>
      {{#if @root.editable}}<a class="sb-mg-gm sb-sk-gm{{#unless gmOnly}} pub{{/unless}}" data-action="sb-skill-gm" data-key="{{key}}" title="Post to everyone (eye) or whisper to the GM only (crossed eye)"><i class="fas {{#if gmOnly}}fa-eye-slash{{else}}fa-eye{{/if}}"></i> {{#if gmOnly}}{{localize "SW25.SB.GmOnly"}}{{else}}{{localize "SW25.SB.Public"}}{{/if}}</a>
      <span class="sb-edit-only"><a data-action="skill-edit" data-index="{{i}}" title="Edit skill"><i class="fas fa-edit"></i></a><a class="sb-del" data-action="del" data-field="uniqueSkills" data-index="{{i}}" title="Delete skill"><i class="fas fa-times"></i></a></span>{{/if}}
    </span>
  </div>
  {{#if description}}<div class="sb-desc">{{{description}}}</div>{{/if}}
</div>{{/unless}}{{else}}<div class="sb-skill muted">None</div>{{/each}}
<h3>Loot <small>(2d · Sword Shards {{> "systems/sw25-ce/templates/actor/sb/sb-num.hbs" n=stats.swordShards}})</small> {{#if isGM}}<a class="sb-btn sb-lootbtn" data-action="sb-loot" title="{{localize 'SW25.SB.LootHint'}}"><i class="fas fa-dice"></i> {{localize "SW25.SB.RollLoot"}}</a>{{/if}} {{#if editable}}<a class="sb-add" data-action="add" data-field="loot"><i class="fas fa-plus"></i></a>{{/if}}</h3>
<table class="sb-table"><thead><tr><th>Roll</th><th>Item</th><th>Price</th><th>Material card</th><th></th></tr></thead><tbody>
{{#each loot}}<tr><td><input class="sb-in w-roll" type="text" name="system.sb.loot.{{i}}.roll" value="{{roll}}"></td><td><input class="sb-in" type="text" name="system.sb.loot.{{i}}.item" value="{{item}}"></td><td><input class="sb-in w-xs" type="text" name="system.sb.loot.{{i}}.price" value="{{price}}" data-dtype="Number">G</td><td><input class="sb-in" type="text" name="system.sb.loot.{{i}}.materialCard" value="{{materialCard}}"></td><td>{{#if @root.editable}}<a class="sb-del" data-action="del" data-field="loot" data-index="{{i}}"><i class="fas fa-times"></i></a>{{/if}}</td></tr>{{else}}<tr><td colspan="5" class="muted">No loot</td></tr>{{/each}}
</tbody></table>
