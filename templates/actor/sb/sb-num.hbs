<span class="sb-num{{#if n.locked}} is-locked{{/if}}"><input class="sb-in" type="text" name="system.sb.{{n.path}}" value="{{n.edit}}" data-dtype="Number" placeholder="—" {{#unless @root.editable}}disabled{{/unless}}>{{#if n.locked}}<img class="sb-quill" src="{{@root.quill}}" data-action="lock" data-path="{{n.path}}" title="Hand-edited (locked) – click to unlock">{{else}}{{#if @root.editable}}<a class="sb-lock" data-action="lock" data-path="{{n.path}}" title="Lock this value (manual override)"><i class="fas fa-feather"></i></a>{{/if}}{{/if}}</span>
