<span class="sb-num{{#if n.locked}} is-locked{{/if}}{{#if n.boost}} sw25-shard-boost{{/if}}"{{#if n.boost}} title="{{n.boost.tip}}"{{/if}}><input class="sb-in" type="text" name="system.sb.{{n.path}}" value="{{#if n.boost}}{{#if @root.editMode}}{{n.edit}}{{else}}{{n.value}}{{/if}}{{else}}{{n.edit}}{{/if}}" data-dtype="Number" placeholder="—" {{#unless @root.editable}}disabled{{/unless}}>{{#if n.locked}}<img class="sb-quill" src="{{@root.quill}}" data-action="lock" data-path="{{n.path}}" title="Hand-edited (locked) – click to unlock">{{else}}{{#if @root.editable}}<a class="sb-lock" data-action="lock" data-path="{{n.path}}" title="Lock this value (manual override)"><i class="fas fa-feather"></i></a>{{/if}}{{/if}}{{#if n.boost}}{{#if @root.editMode}}<b class="sw25-shard-add">+{{n.boost.add}}</b>{{/if}}{{/if}}</span>
