{{#if c}}<span class="sb-rollpair{{#if c.boost}} sw25-shard-boost{{/if}}"{{#if c.boost}} title="{{c.boost.tip}}"{{/if}}><a class="sb-btn sb-fx" data-action="sb-check" data-mode="fixed" data-label="{{c.label}}" data-fixed="{{c.fixed}}" title="{{localize 'SW25.SB.FixedHint'}}"><i class="fas fa-square"></i> {{c.fixed}}</a><a class="sb-btn sb-dice" data-action="sb-check" data-mode="dice" data-label="{{c.label}}" data-fixed="{{c.fixed}}" title="{{localize 'SW25.SB.DiceHint'}}"><i class="fas fa-dice"></i> {{c.formula}}</a></span>{{else}}<span class="muted">—</span>{{/if}}
